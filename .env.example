APP_NAME=Permutare
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/permutare/public

# Opcional em producao: cole aqui a string oficial do Supabase Session Pooler.
# Se DATABASE_URL estiver preenchida, ela tem prioridade sobre DB_HOST, DB_USER etc.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=3306
DB_CONNECTION=mysql
DB_NAME=permutare
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_SSLMODE=prefer

UPLOAD_MAX_SIZE=2097152
SESSION_NAME=permutare_session
